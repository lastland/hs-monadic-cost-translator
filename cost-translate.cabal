cabal-version:      3.0
name:               cost-translate
version:            0.1.0.0
synopsis:           Translate pure Haskell to a monadic cost interface (proof of concept)
build-type:         Simple
license:            MIT
license-file:       LICENSE
-- The translator uses this compiler's internal GHC API. Other versions are
-- unsupported; build-depends below enforces this independently of the script.
tested-with:        GHC ==9.10.3
data-files:
    cost-translate.cabal
    examples/README.md
    examples/ThunkArguments.hs
    examples/ThunkMatching.hs
    examples/ScopedAnnotations.hs
    examples/ConstructorEquations.hs
    examples/TerminalDo.hs
    integration/cost-translate-integration.cabal
    integration/test-integration/Main.hs
    test/*.hs
    test/cases/**/*.hs
    test/reference/*.hs
    test/reference-selftest/*.hs
    test/reference-policy/**/*.hs
    test/reference-policy/**/*.cabal
    test/generated-functions/*.hs
    test/generated-functions/*.sh
    test/generated-construction/*.hs
    test/runtime-allocator/*.hs
extra-source-files:
    .githooks/pre-commit
    .hlint.yaml
    .shellcheckrc
    fourmolu.yaml
    docs/source-policy.md
    patches/README.md
    patches/memorist-private-allocator.patch
    .scratch/translator-poc/scanl-demand-fix.patch
    examples/VALIDATION.md
    scripts/stack-compiler.yaml
    scripts/*.sh
    scripts/*.py
    scripts/source-policy.json
    test/*.py
    test/comment-policy/*.txt
    test/source-policy/*.txt
    test/CommentPolicy.hs
    test/OutputAstProbe.hs
    test/RuntimeFilterGate.hs
    test/RuntimeScanlGate.hs
    test/RuntimeScanlCandidate.hs
    test/RuntimePolymorphicSharingGate.hs
    test/RuntimeHigherKindedGate.hs

common settings
    default-language: GHC2021
    ghc-options:      -Wall

library
    import:           settings
    hs-source-dirs:   src
    exposed-modules:
        Cost.Translate
    other-modules:
        Cost.Translate.Frontend
        Cost.Translate.Frontend.Allocation
        Cost.Translate.Frontend.Emit
        Cost.Translate.Frontend.Environment
        Cost.Translate.Frontend.Expressions
        Cost.Translate.Frontend.Gates
        Cost.Translate.Frontend.LocalValues
        Cost.Translate.Frontend.Logs
        Cost.Translate.Frontend.Module
        Cost.Translate.Frontend.ModulePlan
        Cost.Translate.Frontend.NamePlan
        Cost.Translate.Frontend.PatternPaths
        Cost.Translate.Frontend.Patterns
        Cost.Translate.Frontend.Polymorphic
        Cost.Translate.Frontend.Prepare
        Cost.Translate.Frontend.Prune
        Cost.Translate.Frontend.Resolve
        Cost.Translate.Frontend.Sections
        Cost.Translate.Frontend.Signatures
        Cost.Translate.Frontend.Strict
        Cost.Translate.Frontend.Syntax
        Cost.Translate.Datatypes
        Cost.Translate.Datatypes.Assembly
        Cost.Translate.Datatypes.BuiltinDemand
        Cost.Translate.Datatypes.CharSupport
        Cost.Translate.Datatypes.Constructor
        Cost.Translate.Datatypes.Conversion
        Cost.Translate.Datatypes.Declaration
        Cost.Translate.Datatypes.Demand
        Cost.Translate.Datatypes.DemandSupport
        Cost.Translate.Datatypes.Generation
        Cost.Translate.Datatypes.Selectors
        Cost.Translate.Datatypes.Types
        Cost.Translate.Names
        Cost.Translate.Pretty
        Cost.Translate.Foldable
        Cost.Translate.Validation
        Cost.Translate.Kinds
        Cost.Translate.Kinds.Lifting
        Cost.Translate.Kinds.Mapping
        Cost.Translate.Kinds.Requirements
        Cost.Translate.Sharing
        Cost.Translate.Sharing.Keys
        Cost.Translate.Sharing.Native
        Cost.Translate.Sharing.NativeSupport
        Cost.Translate.Sharing.Paths
        Cost.Translate.Sharing.Projection
        Cost.Translate.Sharing.Reflected
        Cost.Translate.Sharing.ReflectionTypes
        Cost.Translate.Sharing.Residual
        Cost.Translate.Sharing.Schema
        Cost.Translate.Sharing.Specialization
        Cost.Translate.Sharing.Structural
        Cost.Translate.Sharing.Support
        Cost.Translate.Callable
        Cost.Translate.Diagnostic
        Cost.Translate.Typed
        Cost.Translate.Specialize
        Cost.Translate.Specialize.Analysis
        Cost.Translate.Specialize.Selection
        Cost.Translate.Output
        Cost.Translate.Output.Ast
        Cost.Translate.Output.Binders
        Cost.Translate.Output.Declarations
        Cost.Translate.Output.Expressions
        Cost.Translate.Output.Modules
        Cost.Translate.Output.Patterns
        Cost.Translate.Output.Statements
        Cost.Translate.Output.Types
    build-depends:
        base >=4.18 && <5,
        ghc ==9.10.3,
        ghc-boot-th ==9.10.3,
        ghc-paths,
        containers,
        directory,
        filepath,
        process,
        temporary,
        transformers

executable cost-translate
    import:           settings
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        base,
        cost-translate

test-suite cost-translate-test
    import:           settings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    FixturePolicy
                     GeneratedChecks
                     GeneratedConstruction
                     ConstructionAst
                     ConstructionRuntime
                     ConstructionHomeRepr
                     ConstructionDictionary
                     ConstructionDefaults
                     ConstructionEvidence
                     ConstructionRoles
                     ConstructionQuickCheckUses
                     ConstructionSyntax
                     ConstructionViews
                     GeneratedFunctions
                     ReferencePolicy
                     ReferenceRunner
                     RuntimeAllocator
                     Paths_cost_translate
    autogen-modules:  Paths_cost_translate
    build-depends:
        base,
        cost-translate,
        containers,
        directory,
        filepath,
        ghc ==9.10.3,
        ghc-paths,
        process,
        temporary
